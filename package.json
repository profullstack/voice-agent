{
  "name": "@profullstack/voice-agent",
  "version": "0.1.1",
  "description": "Phone voice agents that hold a real conversation: define one in code (persona, voice, model, webhook tools), deploy it to ElevenLabs Conversational AI with a SIP address, dial it into any call, and answer its tools from your server. The brain behind group.call's agents and the Off The Record host.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/voice-agent.git"
  },
  "homepage": "https://github.com/profullstack/voice-agent",
  "keywords": ["voice agent", "elevenlabs", "conversational ai", "sip", "telnyx", "phone", "ai agents", "webhook tools"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "voice-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
